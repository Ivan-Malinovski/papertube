# Papertube Configuration
# Copy this file to .env and fill in your values

# Server
PAPERTUBE_HOST=0.0.0.0
PAPERTUBE_PORT=8080

# Security - REQUIRED
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
PAPERTUBE_SECRET_KEY=your-secret-key-here

# JWT Configuration
PAPERTUBE_ALGORITHM=HS256
PAPERTUBE_ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Rate Limiting
PAPERTUBE_LOGIN_MAX_ATTEMPTS=5
PAPERTUBE_LOGIN_LOCKOUT_WINDOW=900
PAPERTUBE_API_RATE_LIMIT_MAX_REQUESTS=10
PAPERTUBE_API_RATE_LIMIT_WINDOW_SECONDS=60

# LLM Configuration
PAPERTUBE_DEFAULT_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
PAPERTUBE_DEFAULT_MODEL=gemini-2.0-flash

# Database
PAPERTUBE_DATABASE_PATH=data/summaries.db
